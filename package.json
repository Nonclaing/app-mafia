    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/vue-query": "^5.90.2",
    "@types/node": "^24.7.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vee-validate/i18n": "^4.15.1",
