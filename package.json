{
  "name": "@intervolga/app-mafia",
  "version": "1.3.1",
  "publishConfig": {
    "registry": "https://gitlab.intervolga.ru/api/v4/projects/1979/packages/npm/"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.development --host",
    "dev:init": "node .dev/init.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "openapi": "openapi-ts",
    "update": "npx npm-check-updates -u && npm i",
    "test": "vitest run",
    "test:ci": "vitest run --bail=1 --reporter=dot",
    "start": "pm2 start .ci/pm2/config.cjs",
    "release": "bush cli/release",
    "type-check": "npm run build && vue-tsc --noEmit -p ./.nuxt/tsconfig.json",
    "setup": "npm i && npm run openapi && npm run dev:init",
    "ci-build": "npm run openapi && npm run dev:init && npm run generate"
  },
