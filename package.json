{
  "name": "nuxt-app",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.development",
    "dev:init": "node .dev/init.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "openapi": "openapi-ts",
    "postinstall": "nuxt prepare && npm run dev:init && npm run openapi",
    "update": "npx npm-check-updates -u && npm i",
    "test": "vitest run",
    "test:ci": "vitest run --bail=1 --reporter=dot",
    "start": "pm2 start .ci/pm2/config.cjs"
  },
  "devDependencies": {
    "@casl/ability": "^6.7.3",
    "@casl/vue": "^2.2.2",
    "@faker-js/faker": "^10.0.0",
    "@hey-api/client-axios": "^0.9.1",
    "@hey-api/openapi-ts": "^0.82.3",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/icon": "^2.0.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/test-utils": "^3.19.2",
    "@nuxtjs/device": "^3.2.4",
    "@nuxtjs/i18n": "^10.0.6",
    "@pinia/nuxt": "^0.11.2",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.12",
    "@typescript-eslint/parser": "^8.42.0",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/nuxt": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "@vee-validate/yup": "^4.15.1",
    "@vueuse/nuxt": "^13.9.0",
    "axios": "^1.11.0",
    "daisyui": "^5.1.6",
    "es-toolkit": "^1.39.10",
    "eslint-plugin-vue": "^10.4.0",
    "happy-dom": "^18.0.1",
    "js-yaml": "^4.1.0",
    "lowdb": "^7.0.1",
    "nuxt": "^4.1.0",
    "nuxt-es-toolkit-module": "^1.0.2",
    "nuxt-headlessui": "^1.2.1",
    "nuxt-schema-org": "^5.0.6",
    "stylelint-config-html": "^1.1.0",
    "tailwindcss": "^4.1.12",
    "vee-validate": "^4.15.1",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.5.1",
    "yup": "^1.7.0"
  }
}
